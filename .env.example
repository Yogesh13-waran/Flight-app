DJANGO_SETTINGS_MODULE=pulsenotify.settings.local
SECRET_KEY=django-insecure-pulsenotify-secret-key-change-in-production-1234567890
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
DB_NAME=pulsenotify_db
DB_USER=pulsenotify_user
DB_PASSWORD=pulsenotify_pass
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Internal Mock Price Feed Base URL
PRICE_FEED_BASE_URL=http://127.0.0.1:8000

