    {
      "name": "2. Price Alerts",
      "item": [
        {
          "name": "2.1 Create Price Alert (Success 201)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": \"DEL\",\n  \"destination\": \"BOM\",\n  \"threshold_price\": \"4500.00\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/alerts/",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts", ""]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData.status).to.eql('active');",
                  "pm.collectionVariables.set(\"alert_id\", jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2.2 List User Alerts (Success 200 - Scoped)",
          "request": {
            "method": "GET",
            "header": [
